# Contoh konfigurasi kredensial Telegram untuk build lokal.
# Salin ke config/.env.local lalu isi nilainya. Jangan commit file .env.local!
#
# Mode utama: akun user via Telethon (limit upload 2 GB, tanpa split).
# API_ID / API_HASH dari https://my.telegram.org (API development tools).
# STRING_SESSION dibuat dengan:
#   pip install telethon
#   python3 scripts/generate-session.py
TELEGRAM_API_ID="1234567"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"
TELEGRAM_STRING_SESSION="1BQANOTEuMTA4L..." 
TELEGRAM_CHANNEL_ID="-1001234567890"

# Opsional: fallback Bot API (batas 50 MB per file, tidak ada split lagi).
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
